{
  "name": "@brain/napi",
  "private": true,
  "version": "0.0.0",
  "description": "Generated Node bindings for brain-core (napi-rs). Build output only — do not hand-edit index.js/index.d.ts.",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "brain-napi",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ]
}
